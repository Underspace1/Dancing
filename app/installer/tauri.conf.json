{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Installer Dancing!",
  "version": "3.0.0",
  "identifier": "com.dancing.setup",
  "build": { "frontendDist": "../installer-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Installer Dancing!", "width": 820, "height": 520, "resizable": false, "maximizable": false, "center": true,
        "decorations": false, "backgroundColor": "#09090b", "dragDropEnabled": false, "zoomHotkeysEnabled": false, "theme": "Dark" }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
