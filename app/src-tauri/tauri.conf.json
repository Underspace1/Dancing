{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dancing!",
  "version": "3.0.0",
  "identifier": "com.replayhud.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dancing!",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#09090b",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "theme": "Dark",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
