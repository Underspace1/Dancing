diff --git a/framework/bass/decode.go b/framework/bass/decode.go
new file mode 100644
index 0000000..2a48771
--- /dev/null
+++ b/framework/bass/decode.go
@@ -0,0 +1,71 @@
+package bass
+
+/*
+#include "bass.h"
+*/
+import "C"
+
+import (
+	"encoding/binary"
+	"errors"
+	"os"
+	"unicode/utf16"
+	"unsafe"
+)
+
+// DecodeToWAV decodes [start, start+dur) seconds of an audio file to a 32-bit float WAV.
+// Used by the Replay HUD export: danser's bundled ffmpeg cannot decode mp3/ogg itself.
+func DecodeToWAV(path string, start, dur float64, out string) error {
+	wFile := append(utf16.Encode([]rune(path)), 0)
+	h := C.BASS_StreamCreateFile(0, unsafe.Pointer(&wFile[0]), 0, 0, C.DWORD(C.BASS_STREAM_DECODE|C.BASS_SAMPLE_FLOAT|C.BASS_STREAM_PRESCAN|C.BASS_UNICODE))
+	if h == 0 {
+		return errors.New("BASS cannot open the audio file")
+	}
+	defer C.BASS_StreamFree(h)
+
+	var info C.BASS_CHANNELINFO
+	C.BASS_ChannelGetInfo(C.DWORD(h), &info)
+	freq, chans := int(info.freq), int(info.chans)
+
+	length := float64(C.BASS_ChannelBytes2Seconds(C.DWORD(h), C.BASS_ChannelGetLength(C.DWORD(h), C.BASS_POS_BYTE)))
+	if start+dur > length {
+		start = max(0, length-dur)
+	}
+	C.BASS_ChannelSetPosition(C.DWORD(h), C.BASS_ChannelSeconds2Bytes(C.DWORD(h), C.double(start)), C.BASS_POS_BYTE)
+
+	want := int(dur*float64(freq)) * chans * 4
+	data := make([]byte, 0, want)
+	buf := make([]byte, 65536)
+	for len(data) < want {
+		n := int32(C.BASS_ChannelGetData(C.DWORD(h), unsafe.Pointer(&buf[0]), C.DWORD(min(len(buf), want-len(data)))))
+		if n <= 0 {
+			break
+		}
+		data = append(data, buf[:n]...)
+	}
+
+	f, err := os.Create(out)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	hdr := make([]byte, 44)
+	copy(hdr[0:], "RIFF")
+	binary.LittleEndian.PutUint32(hdr[4:], uint32(36+len(data)))
+	copy(hdr[8:], "WAVEfmt ")
+	binary.LittleEndian.PutUint32(hdr[16:], 16)
+	binary.LittleEndian.PutUint16(hdr[20:], 3) // IEEE float
+	binary.LittleEndian.PutUint16(hdr[22:], uint16(chans))
+	binary.LittleEndian.PutUint32(hdr[24:], uint32(freq))
+	binary.LittleEndian.PutUint32(hdr[28:], uint32(freq*chans*4))
+	binary.LittleEndian.PutUint16(hdr[32:], uint16(chans*4))
+	binary.LittleEndian.PutUint16(hdr[34:], 32)
+	copy(hdr[36:], "data")
+	binary.LittleEndian.PutUint32(hdr[40:], uint32(len(data)))
+
+	if _, err = f.Write(hdr); err == nil {
+		_, err = f.Write(data)
+	}
+	return err
+}
